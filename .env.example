NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Storage público — banco guarda só path relativo (imoveis/{id}/{uuid}.webp)
# URL final = NEXT_PUBLIC_STORAGE_BASE_URL + "/" + path
# Migrar para Cloudflare R2 = trocar só esta variável (+ hostname em next.config.mjs)
NEXT_PUBLIC_STORAGE_BASE_URL=https://your-project.supabase.co/storage/v1/object/public/property-photos

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=
